 "specimens": [
  {
   "id": "t3-t026-00039",
   "genre": "prayer",
   "pie": "h₁regʷesyéti kʷséps gʷm̥yéti. nu sóh₂wl̥ wódr̥ Hn̥dʰí séngʷs. ph₂ter n̥smé nékʷti h₂lékse. l̥gʰih₁mé swépnos n̥smé h₁pyéh₁t. ḱwṓ nos ḱléytreh₂m h₂léksoyh₁t pérkʷus n̥smé ḱéloyh₁t. bʰudʰih₁mé léwkm̥-kʷe h₂ew dedr̥ḱih₁mé.",
   "english": "It is getting dark, night is coming. Sun, you sank into the water below. Father, guard us in the night! May we lie down, may sleep seize us. May the dog guard our shelter. May the oak cover us. May we wake, and may we see the light again."
  },
  {
   "id": "t3-t002-00006",
   "genre": "hymn",
   "pie": "nu kʷís kʷékʷlom ń̥dʰgʷʰitosyo sh₂wéns dʰéh₁t? ish₁rós-kʷe-ge dyḗws tóm dʰéh₁t. wéǵʰetes HeHḱúh₁ h₁éḱwoh₁ tóm. nu-kʷe deywṓs tóm dedr̥ḱḗr. só ish₁rós h₁ésti só HeHḱús h₁ésti. nu kʷékʷlom sh₂wéns gʷéHyōmes. só nos wewórte só néḱus ne h₁ésti. nu-kʷe h₂lékse n̥smé tóh₁.",
   "english": "Who set the wheel of the imperishable sun? And strong Sky indeed set it. The two swift horses carry it. And the gods see it. It is strong; it is swift. Now let us sing the wheel of the sun. It is turned toward us; it is not mortal. And now protect us with it."
  },
  {
   "id": "t3-t023-00019",
   "genre": "lament",
   "pie": "wíHre h₂epó h₁éys h₂ew ne gʷéms. wésmn̥ toy wésh₂er yugóm-kʷe toy spéḱyoh₂. nu-kʷe h₁regʷesyéti ḱóymoy. h₂isḱóh₂ te memónh₂e-kʷe te.",
   "english": "Husband, you went away; you did not come back. I wear your garment, and I look at your yoke. And now it is getting dark in the household. I seek you, and I remember you."
  },
  {
   "id": "t3-t027-00011",
   "genre": "epic",
   "pie": "tréyes h₂néres móri gʷmént. nu h₁íd h₁wr̥Hú h₁regʷesyét-kʷe. nu pr̥h₂wós h₂éǵt. ḱéywōs mē tr̥mté. móri upér h₁éyomes ḱléwos-kʷe h₂isḱṓmes. nu litént. nu h₁íd h₁íns gʷr̥h₃ét nu h₁éysōm ḱléwos ń̥dʰgʷʰitom.",
   "english": "Three men came to the sea. It was broad, and it was getting dark. Then the first said, \"Dear ones, do not tremble. We shall go over the sea and seek fame.\" They went away. It swallowed them, but their fame is imperishable."
  },
  {
   "id": "t3-t088-00029",
   "genre": "myth",
   "pie": "h₁stā́m dwóh₁ bʰréh₂terh₁e yemHóh₁. dyḗws ne h₁ést sóh₂wl̥-kʷe ne h₁ést. nu sḿ̥teros h₁éterom gʷʰént. dʰéǵʰōm h₁ésyo mémsos kʷért. h₂éḱmonn̥s h₁ésyo h₃sth₁bʰós kʷért. dyḗm h₁ésyo ḱr̥h₂snés kʷért. wédōr h₁ésyo h₁sh₂éns kʷért. tód pr̥h₂wóm némos h₁ést. nu mórtōs deywóybʰos uksénn̥s gʷʰnénti.",
   "english": "There were two brothers, twins. There was no sky, and there was no sun. Then the one killed the other. From his flesh he made the earth. From his bones he made the stones. From his skull he made the sky. From his blood he made the waters. That was the first sacrifice. Now mortals kill bulls for the gods."
  },
  {
   "id": "t3-t026-00010",
   "genre": "myth",
   "pie": "h₃érō úd yéh₂t. sóh₂wl̥ swṓys h₃kʷbʰís spéḱyet. nu h₁íd h₃r̥néy sékʷt. kʷís h₁mé spéḱyeti? wérh₁t. h₁eǵóh₂ twé spéḱyoh₂. méne h₃ókʷih₁ ne trésetes h₁eǵóh₂-kʷe ne bʰebʰóyh₂h₂e. nu sóh₂wl̥ h₃éronm̥ ǵnéh₃t h₁ésmey-kʷe ḱlutóm h₁nómn̥ dʰéh₁t. h₁éy h₂wéyōm h₃rḗǵs.",
   "english": "The eagle was going upwards. He kept looking at the sun with his own eyes. Then it spoke to the eagle: \"Who looks at me?\" He spoke: \"I look at you. My eyes do not tremble, and I am not afraid.\" Then the sun knew the eagle, and set a famous name for him. The eagle is the king of birds."
  },
  {
   "id": "t3-t085-00018",
   "genre": "dialogue",
   "pie": "kúdʰe gʰóstey h₂éyeri h₁éysi? h₂ewsér h₁éymi. méh₂tēr moy méǵh₂i déh₂newi h₁épi tḱéyti. h₁ésyeh₂ey ḱód wéwke. dʰugh₂tḗr toy gʷíh₃weti. kʷíd h₁ésyeh₂s h₁nómn̥? h₁íh₂ h₁suḱléwēs wiḱpóteys h₁widʰéwh₂. h₁íh₂m̥ winédoh₂ h₁ésyeh₂ey-kʷe wérh₁oh₂. príHe moy túH ḱéywos.",
   "english": "Stranger, where are you going in the morning? I am going toward the dawn. My mother dwells by the great river. Tell her this: Your daughter lives. What is her name? She is Of-Good-Fame, the widow of a chief. I will find her and tell her. You are dear to me, friend."
  },
  {
   "id": "t3-t028-00002",
   "genre": "fable",
   "pie": "wl̥kʷíh₂s ḱwónm̥ widét mléwHt wl̥kʷíh₂s. ḱwón túH pleh₁tós h₁eǵóh₂-kʷe tr̥syóh₂. ḱwṓ sékʷt. wĺ̥kʷih₂ méne ḱóymom gʷm̥yé. méne moy pótnih₂ péyh₂tu dédeh₃ti. h₁eǵóh₂ yugtós. séh₂ wérh₁yet. túH yugtós. h₁eǵóh₂ h₁léwdʰereh₂. h₁eǵóh₂ tr̥syóh₂ h₁eǵóh₂-kʷe h₁léwdʰereh₂. nu wl̥kʷíh₂s léytt.",
   "english": "A she-wolf saw a dog. The she-wolf said: \"Dog, you are full, and I thirst.\" The dog said: \"Come to my home, she-wolf. My mistress gives me nourishment. I am yoked.\" She said: \"You are yoked. I am free. I thirst, and I am free.\" Then the she-wolf went away."
  },
  {
   "id": "t3-rl6-005-00008",
   "genre": "riddle",
   "pie": "stestóh₂h₂e ne-kʷe stéygʰoh₂. méne pódes wódr̥ dʰǵʰémi Hn̥dʰí píph₃onti. h₂éweyes swóns nisdóns méne ǵʰóstoysu démonti. péth₂leh₂ sémeh₂i wésh₂er snóygʷʰos-kʷe me ǵʰyémi stégeti. méne h₁nómn̥ wr̥h₁dʰí. dóru.",
   "english": "I stand, and I do not walk. My feet drink water under the earth. Birds build their nests in my hands. In summer I wear leaves, and in winter the snow covers me. Say my name. A tree."
  }
 ]
