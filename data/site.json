 "specimens": [
  {
   "id": "t3-t022-00023",
   "genre": "oath",
   "pie": "h₁óytom ph₂wénh₁ wédn̥h₁ ǵʰoysóh₁-kʷe h₁áyh₂e. bʰoydʰéh₂m ne Hrunépm̥. h₁yód dʰrugʰyṓh₂ péh₂wr̥ me h₁éwse. wódr̥ me gʷr̥h₃é. ǵʰóyse me h₃wth₂dʰí.",
   "english": "I took the oath by fire, by water and by the spear. I did not break the pledge. If I deceive, burn me, Fire! Swallow me, Water! Wound me, Spear!"
  },
  {
   "id": "t3-t043-00005",
   "genre": "proverb",
   "pie": "m̥rént gʷówes m̥rént bʰréh₂teres mért-kʷe mórtos. h₁wésu ḱléwos ne mért. ń̥dʰgʷʰitom h₂n̥rés ḱléwos gʷíh₃weti.",
   "english": "Cattle die, brothers die, and the mortal dies. Good fame does not die. The imperishable fame of a man lives."
  },
  {
   "id": "t3-t023-00019",
   "genre": "lament",
   "pie": "wíHre h₂epó h₁éys h₂ew ne gʷéms. wésmn̥ toy wésh₂er yugóm-kʷe toy spéḱyoh₂. nu-kʷe h₁regʷesyéti ḱóymoy. h₂isḱóh₂ te memónh₂e-kʷe te.",
   "english": "Husband, you went away; you did not come back. I wear your garment, and I look at your yoke. And now it is getting dark in the household. I seek you, and I remember you."
  },
  {
   "id": "t3-b001-00001",
   "genre": "riddle",
   "pie": "kʷíd wóǵʰosyo bʰórom bʰéreti? wéǵʰeti kʷékʷlos tóm.",
   "english": "What carries the burden of the wagon? The wheel transports it."
  },
  {
   "id": "t3-b003-00141",
   "genre": "charm",
   "pie": "litdʰí wĺ̥kʷe h₂éwibʰos mē-kʷe gʷm̥yés.",
   "english": "Wolf, go away from the sheep, and do not come!"
  },
  {
   "id": "t3-t023-00033",
   "genre": "wisdom",
   "pie": "wódr̥ ní h₁éyti péh₂wr̥ úd h₁éyti. péh₂wr̥ wódr̥-kʷe ne ḱéywoyh₁. sóh₂wl̥ h₁éyti nókʷts-kʷe gʷm̥yéti. ḱéleti nókʷts bʰórm̥. h₂éwsōs h₁íh₂m̥ sékʷetor.",
   "english": "Water goes down; fire goes up. Fire and water are not friendly. The sun goes, and the night comes. Night covers the thief. Dawn follows it."
  },
  {
   "id": "t3-b003-00001",
   "genre": "hymn",
   "pie": "dyḗws ph₂tḗr h₁ésti dʰéǵʰōm méh₂tēr h₁ésti.",
   "english": "Sky is father, Earth is mother."
  },
  {
   "id": "t3-t043-00013",
   "genre": "proverb",
   "pie": "wĺ̥kʷos h₂ówins gʷʰénti h₂egʰóm wékʷos h₂n̥rés h₁nómn̥ gʷʰénti. wĺ̥kʷom widéh₁yesi dʰrówgʰom ne widéh₁yesi. ḱwṓ h₂ówins h₂lékseti deywṓs h₁nómn̥ h₂léksonti.",
   "english": "The wolf kills sheep; a bad word kills a man's name. You see the wolf; you do not see the lie. The dog protects the sheep; the gods protect the name."
  },
  {
   "id": "t3-t023-00031",
   "genre": "wisdom",
   "pie": "súHnuh₁ h₁mé ḱlutóm. bʰréh₂tēr lewbʰós. téwe bʰréh₂term̥ mē linkʷtóm. dwóh₁ bʰréh₂terh₁e steh₂róh₁. ḱóm h₁édtom ḱóm píph₃etom. h₁yós h₁ím linékʷti só wĺ̥kʷos.",
   "english": "Two sons, hear me. A brother is dear. Do not leave your brother. Two brothers are stout. Eat together, drink together. Whoever leaves him is a wolf."
  }
