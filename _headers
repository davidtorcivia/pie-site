# Cloudflare Pages headers. Fonts never change: a year. Art, map and audio are sometimes rebuilt under the same name:
# a day. Pages, scripts, styles and data change with each deploy: revalidate.
/art/*
  Cache-Control: public, max-age=86400
/audio/*
  Cache-Control: public, max-age=86400
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/map/*
  Cache-Control: public, max-age=86400
/gardens/*
  Cache-Control: public, max-age=86400
/data/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
